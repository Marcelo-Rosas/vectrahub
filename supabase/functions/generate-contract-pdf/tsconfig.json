{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "*": ["../../../*"],
      "@supabase/supabase-js": ["../../../node_modules/@supabase/supabase-js"],
      "pdf-lib": ["../../../node_modules/pdf-lib"]
    }
  },
  "include": ["./**/*.ts", "../_shared/deno.d.ts"]
}
