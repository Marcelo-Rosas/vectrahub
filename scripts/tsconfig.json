{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "./deno-cli.d.ts",
    "./render-contract-from-payload.ts",
    "./smoke-contract-pdf.ts",
    "./clone-pricing-cargo-to-hub.ts",
    "./smoke-antt-hub-pdf-ui.ts",
    "./convert-packing-xls-to-catalog.ts",
    "./lib/packing-xls-adapters.ts",
    "../src/vite-env.d.ts"
  ]
}
