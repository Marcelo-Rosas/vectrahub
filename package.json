{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "npm run lint:types && npm run lint:eslint",
    "validate": "bash scripts/validate.sh",
    "validate:ci": "npm run lint && npm run build && npm run test:e2e",
    "validate:ui": "npm run test:e2e:ui",
    "format": "prettier --write src/",
    "docs:claude": "node scripts/patch-claude-md.mjs",
    "deps:browserslist": "npm install caniuse-lite@latest",
    "preview": "npm run build && wrangler dev",
    "preview:static": "vite preview --port 4173",
    "deploy": "npm run build && node scripts/patch-wrangler-pages.mjs && wrangler pages deploy dist --project-name=vectrahub --branch=main",
    "deploy:pages": "node scripts/patch-wrangler-pages.mjs && wrangler pages deploy dist --project-name=vectrahub --branch=main",
    "preview:cf": "wrangler pages dev dist",
    "prepare": "husky",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:local": "cross-env PW_BASE_URL=http://localhost:4173 playwright test",
    "test:e2e:paradas": "cross-env PW_BASE_URL=http://localhost:4173 playwright test tests/e2e/quote-paradas-gating.spec.ts --project=chromium-mocks",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen https://app.vectracargo.com.br",
    "test:e2e:auth": "npx playwright test --project=chromium-auth",
    "test:e2e:mocks": "npx playwright test tests/e2e/quote-*.spec.ts --project=chromium-mocks",
    "test:e2e:seeded": "npx playwright test tests/e2e/flows/*.seeded.spec.ts --project=chromium-auth",
    "audit:trips": "npx tsx scripts/audit-trips.ts",
    "audit:trips:json": "npx tsx scripts/audit-trips.ts --json",
    "montagem:pdf": "deno run -A --config supabase/functions/generate-contract-pdf/deno.json scripts/render-montagem-orcamento-pdf.ts",
    "montagem:email-pdf": "npx tsx scripts/render-montagem-orcamento-email-pdf.ts",
    "montagem:all": "npm run montagem:pdf && npm run montagem:email-pdf",
    "cf:access-public": "node scripts/disable-cloudflare-access-public.mjs",
    "cf:access-public:apply": "node scripts/disable-cloudflare-access-public.mjs --apply",
    "cf:log-explorer": "npx tsx scripts/cloudflare-log-explorer/provision-log-explorer.ts",
    "cf:log-explorer:dry-run": "npm run cf:log-explorer -- --dry-run",
    "cf:log-explorer:apply": "npm run cf:log-explorer -- --apply",
    "cf:log-explorer:retry-access": "npm run cf:log-explorer -- --apply --only access_requests",
    "cf:log-explorer:queries": "npx tsx scripts/cloudflare-log-explorer/run-query.ts --list",
    "cf:log-explorer:query": "npx tsx scripts/cloudflare-log-explorer/run-query.ts",
    "cf:log-explorer:test-all": "node scripts/cloudflare-log-explorer/run-all-tests.mjs",
    "smoke:health": "npx tsx scripts/integration-health.ts",
    "smoke:health:sr": "npx tsx scripts/integration-health.ts --require-sr",
    "smoke:integration": "npx tsx scripts/smoke-integration.ts --report",
    "smoke:integration:real": "npx tsx scripts/smoke-integration.ts --real --report"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ],
    "package.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^10.45.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.83.0",
    "caniuse-lite": "^1.0.30001780",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.1.1",
    "framer-motion": "^12.25.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "motion": "^12.38.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.61.1",
    "react-leaflet": "^4.2.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0",
    "xlsx": "^0.18.5"
  }
}
