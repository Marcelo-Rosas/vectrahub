# Sentry (opcional — monitoramento de erros em produção)
# Obtenha o DSN em: sentry.io → Projeto → Settings → Client Keys (DSN)
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>

# Supabase (obrigatório para o frontend)
# Dashboard → Project Settings → API → anon / publishable (NUNCA service_role no frontend)
VITE_SUPABASE_URL=https://epgedaiukjippepujuzc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-ou-sb_publishable_do_dashboard>
VITE_SUPABASE_PROJECT_ID=epgedaiukjippepujuzc

# Cloudflare Pages / Workers (setar como secret no dashboard da Cloudflare)
# wrangler secret put VITE_CFN_API_KEY
VITE_CFN_API_KEY=<your-cfn-api-key>

# Log Explorer — provisionamento via npm run cf:log-explorer (scripts/cloudflare-log-explorer/)
# Token: API Token com Account → Analytics → Edit e Logs → Edit
# CLOUDFLARE_API_TOKEN=          # Pages deploy (CI)
# CLOUDFLARE_ZERO_TRUST_API_TOKEN=  # Remover Access: template "Edit Cloudflare Zero Trust" (CI + npm run cf:access-public:apply)
# CLOUDFLARE_ACCOUNT_ID=<32-char-account-id>
# CLOUDFLARE_ZONE_ID=<32-char-zone-id>

# Playwright E2E (opcional - só para testes autenticados)
# PW_BASE_URL=https://app.vectracargo.com.br
# PW_TEST_USER=marcelo.rosas@vectracargo.com.br
# PW_TEST_PASSWORD=Vectra@179mr$$   

# E2E seed (obrigatório só para specs *.seeded.spec.ts - backend real)
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SR_KEY=<your-supabase-sr-key>

# Auditoria de trips (npm run audit:trips) — chave admin para bypass RLS
# Use o mesmo valor de SUPABASE_SR_KEY se já tiver; senão obtenha em Supabase → Settings → API

# NF-e XML (Edge validate-document / emit-cte) — secret no Supabase, não no Vite
# MEUDANFE_API_KEY=          # web.meudanfe.com.br → API / Integração
# MEUDANFE_BASE_URL=https://api.meudanfe.com.br/v2
# SEFAZ_PROXY_URL=           # SOAP A1 (situação; dest só se o XML vier no SOAP)
# SEFAZ_PROXY_SECRET=

# CIOT Bridge (microserviço Windows para GeradorCIOT.exe)
# CIOT_BRIDGE_URL=http://localhost:8080
# CIOT_COMPANY_CNPJ=00000000000191
# CIOT_TRANSPORTER_CNPJ=00000000000191
# CIOT_AMBIENTE=homologacao
# SUPABASE_SR_KEY=<your-supabase-sr-key>

# Notification hub (Edge Function notification-hub)
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=<your-evolution-api-key>
# EVOLUTION_INSTANCE=<your-instance-name>

# Google Maps API (para validação de CEP e visualização de rotas)
# Obtenha em: https://console.cloud.google.com → Credentials → Create API Key
# Habilite: Geocoding API + Maps JavaScript API
# Restringir por: HTTP referrers (websites) - adicione localhost:5173 para dev
VITE_GOOGLE_MAPS_API_KEY=AIzaSyC70xZT4985_l_2Qh5xU670Wg73QrL1_hU
