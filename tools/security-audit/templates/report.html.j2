<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <title>Security Audit — {{ report.run_id }}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; background: #f8f9fa; color: #212529; }
    h1 { margin-bottom: 0.25rem; }
    .meta { color: #6c757d; margin-bottom: 1.5rem; }
    .counts { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .badge { padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; }
    .critical { background: #f8d7da; color: #842029; }
    .high { background: #fff3cd; color: #664d03; }
    .medium { background: #cff4fc; color: #055160; }
    .low { background: #e2e3e5; color: #41464b; }
    .info { background: #d1e7dd; color: #0f5132; }
    table { width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    th, td { padding: 0.75rem; text-align: left; border-bottom: 1px solid #dee2e6; vertical-align: top; }
    th { background: #343a40; color: #fff; }
    tr.sev-critical { background: #fff5f5; }
    tr.sev-high { background: #fffbf0; }
    tr.sev-medium { background: #f0f9ff; }
    .snippet { font-family: monospace; font-size: 0.85rem; max-width: 400px; overflow: hidden; text-overflow: ellipsis; }
    footer { margin-top: 2rem; color: #6c757d; font-size: 0.875rem; }
  </style>
</head>
<body>
  <h1>SaaS Security Audit Report</h1>
  <p class="meta">
    Run {{ report.run_id }} · {{ report.mode }} · {{ report.target_summary }}<br/>
    {{ report.started_at }} → {{ report.finished_at or 'in progress' }}
    {% if report.critical_stop_triggered %}
    · <strong style="color:#842029">CRITICAL STOP</strong>
    {% endif %}
  </p>
  <div class="counts">
    <span class="badge critical">Critical: {{ counts.critical }}</span>
    <span class="badge high">High: {{ counts.high }}</span>
    <span class="badge medium">Medium: {{ counts.medium }}</span>
    <span class="badge low">Low: {{ counts.low }}</span>
    <span class="badge info">Info: {{ counts.info }}</span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Severity</th>
        <th>Scanner</th>
        <th>Title</th>
        <th>CVSS</th>
        <th>Description</th>
        <th>Remediation</th>
      </tr>
    </thead>
    <tbody>
      {% for f in findings %}
      <tr class="sev-{{ f.severity }}">
        <td><strong>{{ f.severity }}</strong></td>
        <td>{{ f.scanner }}</td>
        <td>{{ f.title }}</td>
        <td>{{ f.cvss_score }}</td>
        <td>{{ f.description }}</td>
        <td>{{ f.remediation }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if skipped %}
  <h2>Skipped scanners</h2>
  <ul>
    {% for s in skipped %}
    <li><code>{{ s.scanner }}</code>: {{ s.reason }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  <footer>Generated by saas-security-audit · OWASP-aligned DAST</footer>
</body>
</html>
